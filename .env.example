DISCORD_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-server-id

# Optional locally; on Railway attach a persistent volume mounted at /data.
# DATA_DIR=/data

# Leave empty to disable the HTTP receiver. Use a random secret of >=32 characters.
# Set the same secret ONLY in the Aether website backend environment.
AETHER_INTEGRATION_SECRET=
INTEGRATION_HOST=0.0.0.0
INTEGRATION_PORT=8080
# Railway's PORT overrides INTEGRATION_PORT when present.

# Detection is always enabled. Public digests are opt-in (comma separated).
# Supported: pb,milestone,league,incentive,rank
ANNOUNCE_ACHIEVEMENTS=
DIAMOND_MILESTONES=100000,250000,500000,1000000,2500000,5000000

# Server-only bot-to-website report sync. Never use these in browser scripts.
# Apply website/database/007_report_ingestion.sql before enabling.
SUPABASE_URL=https://qshisvghfowafifxwjwa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: map export manager display names to real manager emails/usernames.
# Manager email exports resolve directly after website migration 017.
REPORT_MANAGER_ALIASES={}

# Accepted-application onboarding (enable after migration 009 and site deployment).
ONBOARDING_ENABLED=false
ONBOARDING_PENDING_ROLE_ID=
ONBOARDING_CREATOR_ROLE_ID=
# Resend sending key and a sender on your verified domain.
RESEND_API_KEY=
ONBOARDING_EMAIL_FROM=
